+/// A native key plus the text committed by its keyboard layout. Windows names
+/// dead-key + Space as Space even though its text is "~", "'", etc. Invalid
+/// combinations can commit two characters. Neither case can use logical_key alone.
+pub(crate) fn map_input(event: &winit::event::KeyEvent, m: ModifiersState) -> Option<KeyEvent> {
+    let mapped = map_key(&event.logical_key, m);
+    #[cfg(target_os = "windows")]
+    let mapped = mapped.map(|mut key| {
+        let text_input = !key.mods.cmd || (key.mods.ctrl && key.mods.alt);
+        if event.state.is_pressed() && text_input
+            && matches!(key.key, Key::Text(_) | Key::Command(_))
+            && let Some(text) = event.text.as_ref().filter(|s| !s.is_empty() && !s.chars().any(char::is_control))
+        {
+            key.key = Key::Text(text.to_string());
+        }
+        key
+    });
+    mapped
+}
