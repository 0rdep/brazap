+// Adapted from anomalyco/rune#46: DXGI's first hardware adapter follows the
+// Windows default/primary display instead of forcing the lowest-power GPU.
+// Explicit WGPU_ADAPTER_NAME and WGPU_POWER_PREF choices above still win.
+#[cfg(target_os = "windows")]
+fn windows_default(instance: &wgpu::Instance, surface: Option<&wgpu::Surface<'_>>) -> Option<wgpu::Adapter> {
+    use windows::Win32::Graphics::Dxgi::*;
+    let factory = unsafe { CreateDXGIFactory1::<IDXGIFactory1>() }.ok()?;
+    let mut card = None;
+    for index in 0.. {
+        let Ok(adapter) = (unsafe { factory.EnumAdapters1(index) }) else { break };
+        let Ok(desc) = (unsafe { adapter.GetDesc1() }) else { continue };
+        if desc.Flags & DXGI_ADAPTER_FLAG_SOFTWARE.0 as u32 == 0 {
+            card = Some((desc.VendorId, desc.DeviceId));
+            break;
+        }
+    }
+    let card = card?;
+    pollster::block_on(instance.enumerate_adapters(wgpu::Backends::DX12))
+        .into_iter().find(|adapter| {
+            let info = adapter.get_info();
+            (info.vendor, info.device) == card
+                && surface.is_none_or(|surface| adapter.is_surface_supported(surface))
+        })
+}
