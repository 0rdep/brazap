+// First-frame reveal, backported from upstream Rune.
+use windows_sys::Win32::Graphics::Dwm::{DWMWA_CLOAK, DWMWA_TRANSITIONS_FORCEDISABLED, DwmFlush, DwmSetWindowAttribute};
+
+/// A cloaked window's give-up time: one whose frame never comes still shows by then.
+#[derive(Default)]
+pub(crate) struct Cloak {
+    until: Cell<Option<std::time::Instant>>,
+}
+
+impl Cloak {
+    /// Cloaks the window until `lift`, or `until` at the latest.
+    pub(crate) fn hold(&self, window: &winit::window::Window, until: std::time::Instant) {
+        transitions(window, true);
+        if set(window, true) { self.until.set(Some(until)); }
+        else { transitions(window, false); }
+    }
+
+    pub(crate) fn held(&self) -> bool { self.until.get().is_some() }
+
+    /// Moves a held cloak's deadline, as when making the GPU took part of it.
+    pub(crate) fn extend(&self, until: std::time::Instant) {
+        if self.held() { self.until.set(Some(until)); }
+    }
+
+    /// When the cloak gives up on a frame.
+    pub(crate) fn deadline(&self) -> Option<std::time::Instant> { self.until.get() }
+
+    /// Uncloaks: its frame landed, or `now` is past the deadline.
+    pub(crate) fn lift(&self, window: &winit::window::Window) {
+        if self.until.take().is_some() {
+            // GPU completion alone does not mean DWM has consumed the present.
+            // Keep the native show animation from exposing an old redirection frame.
+            unsafe { let _ = DwmFlush(); }
+            set(window, false);
+            unsafe { let _ = DwmFlush(); }
+            transitions(window, false);
+        }
+    }
+
+    pub(crate) fn lift_if_due(&self, window: &winit::window::Window, now: std::time::Instant) {
+        if self.until.get().is_some_and(|until| until <= now) { self.lift(window); }
+    }
+}
+
+fn set(window: &winit::window::Window, cloaked: bool) -> bool {
+    let Some(hwnd) = hwnd(window) else { return false };
+    let value = i32::from(cloaked);
+    // SAFETY: DWMWA_CLOAK reads one BOOL from `value` for a window this thread owns.
+    unsafe { DwmSetWindowAttribute(hwnd, DWMWA_CLOAK as u32, (&raw const value).cast(), 4) >= 0 }
+}
+
+fn transitions(window: &winit::window::Window, disabled: bool) {
+    let Some(hwnd) = hwnd(window) else { return };
+    let value = i32::from(disabled);
+    // SAFETY: this BOOL configures transitions for the window this thread owns.
+    unsafe { let _ = DwmSetWindowAttribute(hwnd, DWMWA_TRANSITIONS_FORCEDISABLED as u32, (&raw const value).cast(), 4); }
+}
